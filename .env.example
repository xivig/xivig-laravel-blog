APP_NAME="XIVIG Maison Gazette"
APP_ENV=production
APP_KEY=base64:7uQpY4l8r9uN3vGkC0eRt+Z1XwS8bLmO9yF3pA4rT7s=
APP_DEBUG=false
APP_URL=https://gazette.xivig.com
APP_TIMEZONE=Europe/Paris
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# =========================================================================
# PRODUCTION DATABASE CONFIGURATION (MySQL 8.0+ / MariaDB 10.5+ Recommended)
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xivig_gazette_prod
DB_USERNAME=xivig_db_user
DB_PASSWORD=YourSecureDatabasePasswordHere!2027

# For local development with SQLite (uncomment below and comment MySQL above):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# =========================================================================
# PRODUCTION MAIL CONFIGURATION (SMTP / SES / Resend / Mailgun)
# =========================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@yourdomain.com
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="gazette@xivig.com"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
# BLOG & MEDIA EDITORIAL SETTINGS
# =========================================================================
BLOG_POSTS_PER_PAGE=9
BLOG_COMMENT_MODERATION=true
BLOG_MAX_UPLOAD_SIZE_MB=15

# =========================================================================
# INITIAL ADMINISTRATOR PROVISIONING (Used during php artisan db:seed)
# If omitted in production, db:seed generates a 24-character random password.
# Staff accounts can also be provisioned via: php artisan admin:provision
# =========================================================================
INITIAL_ADMIN_NAME="Maison Administrator"
INITIAL_ADMIN_EMAIL="admin@yourdomain.com"
INITIAL_ADMIN_PASSWORD=
